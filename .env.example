# Copia este fichero como .env y rellena los valores de tu proyecto Supabase
# (Project Settings → API). En Vercel defínelas en Settings → Environment Variables.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-clave-publishable-o-anon

# Opcional: contraseñas de las cuentas de demostración. Si se definen, el login
# muestra el panel de "Acceso rápido" que rellena las credenciales con un clic.
# Nunca escribas aquí contraseñas reales: este fichero de ejemplo sí se sube a Git.
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
