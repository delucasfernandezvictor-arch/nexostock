{
  "name": "nexostock",
  "version": "1.0.0",
  "description": "NexoStock · Sistema de gestión de inventario y pedidos multiplataforma (PWA / híbrida) con Ionic + Angular + Supabase",
  "author": "Victor de Lucas",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "config": "node scripts/set-env.mjs",
    "prestart": "npm run config",
    "start": "ng serve",
    "prebuild": "npm run config",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run config",
    "test": "ng test",
    "test:ci": "npm run config && ng test --watch=false",
    "lint": "ng lint",
    "docs": "compodoc -p tsconfig.doc.json -d documentation --includes docs --includesName \"Manual de usuario\" --name \"NexoStock · Documentación técnica\" --language es-ES --hideGenerator",
    "docs:serve": "compodoc -p tsconfig.doc.json -d documentation --language es-ES -s",
    "docs:publish": "compodoc -p tsconfig.doc.json -d www/docs --includes docs --includesName \"Manual de usuario\" --name \"NexoStock · Documentación técnica\" --language es-ES --hideGenerator",
    "vercel-build": "npm run test:ci && npm run build && npm run docs:publish"
  },
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/service-worker": "22.1.7",
    "@capacitor/core": "8.5.3",
    "@ionic/angular": "^9.0.0",
    "@ngrx/signals": "^22.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "chart.js": "^4.6.1",
    "ionicons": "^8.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@capacitor/cli": "8.5.3",
    "@compodoc/compodoc": "^2.0.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~4.0.18"
  }
}
